/** 未知海域 v0.10 classroom leaderboard. Private Sheet; no real names required.
 * Only doGet / voyagePing / voyageBoard / voyageSubmit are public.
 * Deploy as teacher, web app access per school policy. Never publish the Sheet itself.
 */
var VOYAGE_VERSION_='0.10.0';
var HEADERS_=['run_id','receipt','created_at','class_key','alias','route','ending','completed','days','steps','elapsed_seconds','score','places','cards','obstacles','improvements','game_version','payload_hash'];
function doGet(){var url=ScriptApp.getService().getUrl()||'';if(!/^https:\/\/script\.google\.com\//.test(url))url='';return HtmlService.createHtmlOutput(loadGameHtml_().replace('__CLOUD_EXEC_URL__',url)).setTitle('未知海域：航海家的傳奇').addMetaTag('viewport','width=device-width,initial-scale=1,viewport-fit=cover').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function loadGameHtml_(){var id=PropertiesService.getScriptProperties().getProperty('GAME_FILE_ID');var html=id?DriveApp.getFileById(id).getBlob().getDataAsString('UTF-8'):HtmlService.createHtmlOutputFromFile('Game').getContent();if(html.indexOf('VoyageAssets')<0||html.indexOf('__CLOUD_EXEC_URL__')<0)throw Error('請選本版本的 cloud/Game.html，不是本機HTML。');return html;}
function voyagePing(p){if(!p||p.protocol!==1)return fail_('INVALID_INPUT');var props=PropertiesService.getScriptProperties();return {ok:true,protocol:1,version:VOYAGE_VERSION_,ready:!!props.getProperty('SHEET_ID')&&!!props.getProperty('CLASS_HASH'),open:props.getProperty('CLASS_OPEN')==='true'};}
/** Run once in the teacher's Script editor after setting Script Property CLASS_CODE (6–32 letters/digits).
 * Bound project uses its parent Sheet. Standalone: set SHEET_ID first.
 * Re-running preserves existing scores; CLASS_CODE is deleted after its hash is saved.
 */
function setup_(){var props=PropertiesService.getScriptProperties(),id=props.getProperty('SHEET_ID'),active;if(!id){active=SpreadsheetApp.getActiveSpreadsheet();if(!active)throw Error('請先設定 SHEET_ID，或從排行榜試算表開啟綁定腳本。');id=active.getId();props.setProperty('SHEET_ID',id);}var book=SpreadsheetApp.openById(id),sheet=book.getSheetByName('Scores');if(!sheet)sheet=book.insertSheet('Scores');if(sheet.getLastRow()===0)sheet.getRange(1,1,1,HEADERS_.length).setValues([HEADERS_]);assertHeaders_(sheet);sheet.setFrozenRows(1);sheet.getRange(1,1,1,HEADERS_.length).setBackground('#173f49').setFontColor('#ffffff').setFontWeight('bold');sheet.setColumnWidth(5,140);sheet.setColumnWidth(3,200);var code=props.getProperty('CLASS_CODE');if(code){if(!/^[A-Za-z0-9_-]{6,32}$/.test(code))throw Error('CLASS_CODE 請用6至32位英文字母、數字、底線。');var salt=props.getProperty('CLASS_SALT')||Utilities.getUuid();props.setProperty('CLASS_SALT',salt);props.setProperty('CLASS_HASH',hash_(salt+':'+code));props.deleteProperty('CLASS_CODE');}if(!props.getProperty('CLASS_HASH'))throw Error('請在指令碼屬性加入 CLASS_CODE，再執行 setup_。');if(!props.getProperty('CLASS_EXPIRES'))props.setProperty('CLASS_EXPIRES',String(Date.now()+30*86400000));props.setProperty('CLASS_OPEN','true');props.setProperty('BOARD_REV',Utilities.getUuid());return '已初始化。試算表保持私有；現在可部署網頁應用程式。';}
function config_(code){var p=PropertiesService.getScriptProperties();if(!p.getProperty('SHEET_ID')||!p.getProperty('CLASS_HASH'))throw Error('NOT_CONFIGURED');if(typeof code!=='string'||code.length>32||hash_((p.getProperty('CLASS_SALT')||'')+':'+code)!==p.getProperty('CLASS_HASH'))throw Error('BAD_CLASS_CODE');if(p.getProperty('CLASS_OPEN')!=='true'||Date.now()>Number(p.getProperty('CLASS_EXPIRES')||0))throw Error('CLASS_CLOSED');return {id:p.getProperty('SHEET_ID'),classKey:p.getProperty('CLASS_HASH'),rev:p.getProperty('BOARD_REV')||'0'};}
function sheet_(cfg){var sheet=SpreadsheetApp.openById(cfg.id).getSheetByName('Scores');if(!sheet)throw Error('NOT_CONFIGURED');assertHeaders_(sheet);return sheet;}
function assertHeaders_(sheet){if(JSON.stringify(sheet.getRange(1,1,1,HEADERS_.length).getValues()[0])!==JSON.stringify(HEADERS_))throw Error('SCHEMA_MISMATCH');}
function hash_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s,Utilities.Charset.UTF_8).map(function(b){return ('0'+((b+256)%256).toString(16)).slice(-2);}).join('');}
function fail_(code){return {ok:false,code:code};}
function errorCode_(e){return ['INVALID_INPUT','BAD_CLASS_CODE','CLASS_CLOSED','NOT_CONFIGURED','SCHEMA_MISMATCH','RATE_LIMITED','CLASS_FULL'].indexOf(e.message)>=0?e.message:'SERVICE_ERROR';}
function integer_(v,min,max){return Number.isInteger(v)&&v>=min&&v<=max;}
function ids_(v,allowed){if(!Array.isArray(v)||v.length>allowed.length||new Set(v).size!==v.length||v.some(function(id){return allowed.indexOf(id)<0;}))throw Error('INVALID_INPUT');return v.slice().sort();}
function validate_(p){if(!p||typeof p!=='object'||Array.isArray(p)||JSON.stringify(p).length>10000)throw Error('INVALID_INPUT');var fields=['protocol','gameVersion','classCode','runId','alias','route','ending','completed','days','steps','elapsedSeconds','cards','places','resolved','improvements'];if(Object.keys(p).some(function(k){return fields.indexOf(k)<0;})||p.protocol!==1||p.gameVersion!==VOYAGE_VERSION_)throw Error('INVALID_INPUT');if(typeof p.runId!=='string'||!/^v-[A-Za-z0-9-]{4,95}$/.test(p.runId)||typeof p.alias!=='string'||!/^[A-Za-z0-9\u3400-\u9fff][A-Za-z0-9\u3400-\u9fff _·-]{0,15}$/.test(p.alias))throw Error('INVALID_INPUT');if([null,'east','west'].indexOf(p.route)<0||['legend','captain','scholar','ordinary','return'].indexOf(p.ending)<0||typeof p.completed!=='boolean'||(p.completed&&(!p.route||['ordinary','return'].indexOf(p.ending)>=0))||(!p.completed&&['ordinary','return'].indexOf(p.ending)<0))throw Error('INVALID_INPUT');if(!integer_(p.days,1,300)||!integer_(p.steps,0,1200)||!integer_(p.elapsedSeconds,0,1800))throw Error('INVALID_INPUT');var events=['capeStorm','wind','ration','sail','bird','calm','chart','disease','quarrel','current','rain','merchant','reef','hope','light','repair','stars','storm','supplies','cargo'];var q={runId:p.runId,alias:p.alias,route:p.route,ending:p.ending,completed:p.completed,days:p.days,steps:p.steps,elapsedSeconds:p.elapsedSeconds,gameVersion:p.gameVersion,cards:ids_(p.cards,['aim','motives','dias','cape','gama','indian','malindi','columbus','taino','contact','magellan','mactan','elcano','navigation','supply','scurvy','evidence','empire','history-fiction','technology','round-earth']),places:ids_(p.places,['lisbon','madeira','canary','capeverde','atlanticship','guinea','angola','helena','cape','natal','sofala','mozambique','zanzibar','malindi','oceantrader','arabiansea','calicut','westCurrent','westBirds','atlantic','midAtlanticship','caribbean','caribbean_supply']),resolved:ids_(p.resolved,events),improvements:ids_(p.improvements,events)};if(q.places.indexOf('lisbon')<0||q.completed&&q.places.indexOf(q.route==='west'?'caribbean':'calicut')<0)throw Error('INVALID_INPUT');return q;}
function score_(q){return Math.min(100,(q.completed?30:15)+Math.min(25,q.cards.length*2)+Math.min(20,q.places.length*2)+Math.min(15,q.resolved.length*3)+Math.min(10,q.improvements.length*5));}
function rows_(sheet){var count=sheet.getLastRow()-1;if(count>5000)throw Error('CLASS_FULL');return count>0?sheet.getRange(2,1,count,HEADERS_.length).getValues():[];}
function voyageSubmit(p){var lock;try{var q=validate_(p),cfg=config_(p.classCode),fingerprint=hash_(JSON.stringify(q));lock=LockService.getScriptLock();if(!lock.tryLock(5000))return fail_('BUSY');var sheet=sheet_(cfg),rows=rows_(sheet),old=rows.find(function(r){return r[0]===q.runId&&r[3]===cfg.classKey;});if(old){if(old[17]!==fingerprint)return fail_('RUN_CONFLICT');return {ok:true,status:'duplicate',runId:q.runId,receipt:old[1],score:Number(old[11]),serverTime:String(old[2])};}if(rows.length>=5000)throw Error('CLASS_FULL');var cache=CacheService.getScriptCache(),key='submit:'+cfg.classKey+':'+q.runId;if(cache.get(key))throw Error('RATE_LIMITED');cache.put(key,'1',5);var score=score_(q),receipt=Utilities.getUuid(),now=new Date().toISOString(),row=[q.runId,receipt,now,cfg.classKey,q.alias,q.route||'free',q.ending,q.completed,q.days,q.steps,q.elapsedSeconds,score,q.places.length,q.cards.length,q.resolved.length,q.improvements.length,q.gameVersion,fingerprint];sheet.getRange(sheet.getLastRow()+1,1,1,row.length).setValues([row]);SpreadsheetApp.flush();PropertiesService.getScriptProperties().setProperty('BOARD_REV',Utilities.getUuid());return {ok:true,status:'stored',runId:q.runId,receipt:receipt,score:score,serverTime:now};}catch(e){return fail_(errorCode_(e));}finally{if(lock&&lock.hasLock())lock.releaseLock();}}
function voyageBoard(p){try{if(!p||p.protocol!==1||['score','days','places','cards','obstacles'].indexOf(p.metric)<0||['all','east','west'].indexOf(p.route)<0)throw Error('INVALID_INPUT');var cfg=config_(p.classCode),cache=CacheService.getScriptCache(),key='board:'+cfg.classKey+':'+cfg.rev+':'+p.metric+':'+p.route,cached=cache.get(key);if(cached)return JSON.parse(cached);var rows=rows_(sheet_(cfg)).filter(function(r){return r[3]===cfg.classKey&&(p.route==='all'||r[5]===p.route)&&(p.metric!=='days'||r[7]===true);}).map(function(r){return {alias:String(r[4]),route:String(r[5]),ending:String(r[6]),score:Number(r[11]),days:Number(r[8]),places:Number(r[12]),cards:Number(r[13]),obstacles:Number(r[14])};});rows.sort(function(a,b){var d=p.metric==='days'?a.days-b.days:b[p.metric]-a[p.metric];return d||b.score-a.score||a.alias.localeCompare(b.alias);});var last=null,rank=0;rows=rows.slice(0,100).map(function(r,i){if(r[p.metric]!==last)rank=i+1;last=r[p.metric];r.rank=rank;return r;});var out={ok:true,metric:p.metric,route:p.route,updatedAt:new Date().toISOString(),rows:rows};cache.put(key,JSON.stringify(out),20);return out;}catch(e){return fail_(errorCode_(e));}}
